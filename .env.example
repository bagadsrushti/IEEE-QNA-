# ========================================================
# Multilingual AI Question Clustering - Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local)
# Leave blank to automatically use lightweight in-memory MongoDB for local testing.
# For production, provide your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/question_clustering?retryWrites=true&w=majority
MONGODB_URI=

# Admin Authentication
JWT_SECRET=supersecret_multilingual_clustering_key_2026
ADMIN_EMAIL=admin@clusterai.org
ADMIN_PASSWORD=Admin@12345

# AI Clustering Configuration
# Pretrained Model: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Configurable Cosine Similarity Threshold (0.50 to 0.85). Default 0.65 works reliably across EN, HI, MR, and Hinglish.
SIMILARITY_THRESHOLD=0.65
AI_SERVICE_URL=http://127.0.0.1:8000

# Public URL for QR Code generation
# IMPORTANT: For mobile scanning on LAN, set to your computer's IP (e.g. http://192.168.1.15:5173).
# In production, set to your deployed frontend domain (e.g. https://your-app.vercel.app).
PUBLIC_URL=http://localhost:5173
